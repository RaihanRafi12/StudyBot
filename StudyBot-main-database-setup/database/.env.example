# ============================================================
#  StudyBot — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studybot_db
DB_USER=root
DB_PASS=

# App
APP_NAME=StudyBot
APP_ENV=development
APP_URL=http://localhost
APP_PORT=3000

# JWT / Session Secret (change this to a long random string)
JWT_SECRET=your_secret_key_here
SESSION_SECRET=your_session_secret_here

# File Upload
UPLOAD_DIR=uploads/
MAX_FILE_SIZE_MB=10

# Email (optional, for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@studybot.com
